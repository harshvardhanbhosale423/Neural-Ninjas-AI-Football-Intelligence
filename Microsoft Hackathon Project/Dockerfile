FROM node:22-alpine

ENV NODE_ENV=production
ENV PORT=8000
WORKDIR /app

COPY --chown=node:node index.html styles.css app.js server.mjs ./
USER node

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 CMD ["node", "-e", "fetch('http://127.0.0.1:8000/api/status').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
CMD ["node", "server.mjs"]
